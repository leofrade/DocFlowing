# OmniMarkdown Router - Environment Configuration
# Copy this file to .env to customize settings

# Heuristic Classifier Thresholds
OMNI_MIN_CHARS_PER_PAGE=100
OMNI_MAX_PAGES_SAMPLE=10
OMNI_MATH_SYMBOL_THRESHOLD=3

# Logging Level (DEBUG, INFO, WARNING, ERROR)
OMNI_LOG_LEVEL=INFO

# Optional: Default output directory for converted Markdown files (defaults to Desktop or current working dir)
# OMNI_OUTPUT_DIR=/path/to/output

# Optional: Marker Remote API Microservice (alternative to local PyTorch/GPU)
# MARKER_API_URL=http://localhost:8000/convert
# MARKER_API_KEY=your_marker_api_key_here
# MARKER_TIMEOUT_SECONDS=30.0
